# Ollama Server Configuration
OLLAMA_BASE_URL=http://localhost:11434
TRIAGE_MODEL=qwen2.5:1.5b
DRAFTER_MODEL=qwen2.5:3b
EMBED_MODEL=nomic-embed-text
